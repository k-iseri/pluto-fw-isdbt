#!/bin/sh
# SPDX-License-Identifier: MIT
# S22fpga: Linux 起動後に fpga_manager で PL（FPGA）を再ロードし、AD9361 ドライバを再バインドする。
# 背景: このボード（HamGeek Pluto Nano クローン）はベンダー u-boot が受理する公式ビットストリームでは
# AD9361 のピン配置が合わず、ボード固有のビットストリームが必要。u-boot のローダを介さず、
# Linux 側で /lib/firmware/pluto-pl.bin（byte-swapped .bin）をロードする。
# S23udc（iiod 起動・xo_correction 読み出し）より前に実行する必要がある。
# pluto-pl.bin が無ければ何もしない（純正構成と同じ動作）。

FW=pluto-pl.bin
MGR=/sys/class/fpga_manager/fpga0

case "$1" in
start)
	[ -f /lib/firmware/$FW ] || exit 0
	[ -d $MGR ] || { echo "S22fpga: no fpga_manager"; exit 0; }
	printf "Loading PL from /lib/firmware/%s: " "$FW"
	echo $FW > $MGR/firmware
	i=0
	while [ "$(cat $MGR/state)" != "operating" ] && [ $i -lt 50 ]; do sleep 0.1; i=$((i+1)); done
	echo "$(cat $MGR/state)"
	# AD9361 は初回 probe（公式 PL）で失敗しているので再バインド。成功すれば cf-ad9361 系の
	# deferred probe もカーネルが自動で完了させる。
	if [ ! -e /sys/bus/spi/drivers/ad9361/spi0.0 ]; then
		echo spi0.0 > /sys/bus/spi/drivers/ad9361/bind 2>/dev/null
		i=0
		# cf-ad9361-lpc（deferred probe で遅れて現れる）まで待つ。iiod は起動時に列挙するため必須
		while ! grep -qs "^cf-ad9361-lpc$" /sys/bus/iio/devices/iio:device*/name && [ $i -lt 100 ]; do sleep 0.1; i=$((i+1)); done
	fi
	echo "S22fpga: iio devices: $(ls /sys/bus/iio/devices/ 2>/dev/null | tr '\n' ' ')"
	;;
stop) ;;
*) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
exit 0
