diff --git a/board/pluto/post-build.sh b/board/pluto/post-build.sh
index 03021a49..00e8b167 100755
--- a/board/pluto/post-build.sh
+++ b/board/pluto/post-build.sh
@@ -91,3 +91,11 @@ ln -sf ../../wpa_supplicant/ifupdown.sh ${TARGET_DIR}/etc/network/if-pre-up.d/wp
 ln -sf ../../wpa_supplicant/ifupdown.sh ${TARGET_DIR}/etc/network/if-post-down.d/wpasupplicant
 
 ln -sf device_reboot ${TARGET_DIR}/usr/sbin/pluto_reboot
+
+# pluto-fw-isdbt: 外部 overlay（起動スクリプト・ボード固有 PL イメージ）を rootfs に重ねる。
+# 環境変数 PLUTO_EXTRA_OVERLAY（絶対パス）が指すディレクトリをそのまま TARGET_DIR にコピーする。
+if [ -n "$PLUTO_EXTRA_OVERLAY" ] && [ -d "$PLUTO_EXTRA_OVERLAY" ]; then
+	echo "post-build: applying extra overlay $PLUTO_EXTRA_OVERLAY"
+	cp -a "$PLUTO_EXTRA_OVERLAY"/. "$TARGET_DIR"/
+	find "$TARGET_DIR/lib/firmware" -name .gitignore -delete 2>/dev/null
+fi
